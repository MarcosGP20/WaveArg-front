# Copiar a .env.local para desarrollo. En Vercel: Settings -> Environment Variables.
# Nunca commitear .env.local ni .env.production.

# URL del backend .NET (la usan el proxy /api/backend y el webhook de MP desde el servidor)
NEXT_PUBLIC_API_BASE=http://localhost:5075/api
# Opcional: URL del backend solo para el servidor de Next (si difiere de la publica)
INTERNAL_API_BASE=
# Opcional: base que usa el cliente para llamar a la API (default /api/backend)
NEXT_PUBLIC_API_PROXY_BASE=

# URL publica del frontend (back_urls de MercadoPago). En local, un tunel tipo ngrok.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client ID (Google Cloud Console -> Credentials). El mismo que usa el backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secreto de firma de webhooks (panel de MP -> Webhooks). Obligatorio en produccion.
MERCADOPAGO_WEBHOOK_SECRET=

# Secreto compartido con el backend (Proxy__ClientIpSecret en Render). El proxy /api/backend
# lo manda junto con la IP del navegador para que el rate limit del backend distinga usuarios.
# Obligatorio en produccion; en local se puede dejar vacio. Generar con: openssl rand -base64 32
BACKEND_PROXY_SECRET=

# Misma clave que Jwt__Key del backend (Render). Sólo del lado servidor (sin NEXT_PUBLIC_):
# el middleware y el layout de admin verifican con ella la firma del token de sesión.
# Obligatoria: sin ella nadie puede entrar a /account, /checkout ni /admin.
JWT_SECRET=

# Opcional: milisegundos que el proxy /api/backend espera al backend antes de responder 504.
# Default 30000 (Render free puede tardar en despertar).
BACKEND_TIMEOUT_MS=
